<?xml version="1.0" encoding="UTF-8"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <!--
      "Claude Grid" - an Iron Grit-style data face: big time, date, weekday strip, a battery
      arc, and eight data-field positions, all in JetBrains Mono. A separate app from the
      "Claude Terminal" face so either can be worn and this one is fully revertable.

      This first version lays out the grid with representative values. Making the eight fields
      user-editable via Garmin's native complication editor (API 5.1.0) is the next step.
    -->
    <iq:application
        entry="ClaudeGridApp"
        id="484bb3405cb84a94953d3284a6c58b61"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.3.0"
        name="@Strings.AppName"
        type="watchface">

        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
        </iq:products>

        <iq:permissions/>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
