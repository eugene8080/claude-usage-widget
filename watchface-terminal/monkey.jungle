project.manifest = manifest.xml

# Default build = the VFD style (glowing bitmap time + a full-face mesh, the same scheme as Claude
# Grid). The plain terminal face (font time, no mesh) is compiled by switching these three lines to:
#   base.sourcePath = source
#   base.resourcePath = resources
#   base.excludeAnnotations = glow_time;mesh_overlay
base.sourcePath = source;source-glow
base.resourcePath = resources;resources-glow;resources-mesh
base.excludeAnnotations = font_time;plain_overlay

# Per-family launcher icons (size-specific), same pattern as the watch-app.
fenix847mm.resourcePath = $(base.resourcePath);resources-round-454x454
fenix8pro47mm.resourcePath = $(base.resourcePath);resources-round-454x454
fenix843mm.resourcePath = $(base.resourcePath);resources-round-416x416
